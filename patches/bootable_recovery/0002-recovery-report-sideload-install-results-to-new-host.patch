-    ASSERT_EQ(0, WEXITSTATUS(child_status));
+  ASSERT_EXIT(TestSideloadResult("sideload-host:4096:4096", MinadbdCommandStatus::kSuccess,
+                                "DONEDONE"),
+              ::testing::ExitedWithCode(kMinadbdSuccess), "");
+}
 
-    WriteMinadbdCommandStatus(MinadbdCommandStatus::kSuccess);
+TEST_F(MinadbdServicesTest, SideloadHostV2Service_reports_success) {
+  ASSERT_EXIT(TestSideloadResult("sideload-host-v2:4096:4096", MinadbdCommandStatus::kSuccess,
+                                "DONEDONE"),
+              ::testing::ExitedWithCode(kMinadbdSuccess), "");
+}
 
