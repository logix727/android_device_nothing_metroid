Date: Mon, 10 Aug 2026 19:36:05 -0400
Subject: [PATCH] Settings: locale-safe face-enrollment guidance fallback
 (MTR-023)

Device overlay locales that ship empty Settings strings blank the face
enrollment safety/education guidance. Fall back to the default English
string only when the localized value is empty instead of dropping it.

Change-Id: I97c82958564b473cd50ac14cb4f48cbb8fca9185
---
 .../biometrics/face/FaceEnrollEducation.java  | 18 ++++++++++--
 .../face/FaceEnrollIntroduction.java          | 29 ++++++++++++++-----
 2 files changed, 38 insertions(+), 9 deletions(-)

diff --git a/src/com/android/settings/biometrics/face/FaceEnrollEducation.java b/src/com/android/settings/biometrics/face/FaceEnrollEducation.java
index b35e599..f823242 100644
--- a/src/com/android/settings/biometrics/face/FaceEnrollEducation.java
+++ b/src/com/android/settings/biometrics/face/FaceEnrollEducation.java
@@ -55,6 +55,8 @@ import com.google.android.setupcompat.template.FooterButton;
 import com.google.android.setupcompat.util.WizardManagerHelper;
 import com.google.android.setupdesign.view.IllustrationVideoView;
 
+import java.util.Locale;
+
 /**
  * Provides animated education for users to know how to enroll a face with appropriate posture.
  */
@@ -78,7 +80,7 @@ public class FaceEnrollEducation extends BiometricEnrollBase {
                     final int descriptionRes = isChecked
                             ? R.string.security_settings_face_enroll_education_message_accessibility
                             : R.string.security_settings_face_enroll_education_message;
-                    setDescriptionText(descriptionRes);
+                    setDescriptionText(getTextWithDefaultLocaleFallback(descriptionRes));
 
                     if (isChecked) {
                         hideDefaultIllustration();
@@ -113,7 +115,8 @@ public class FaceEnrollEducation extends BiometricEnrollBase {
         setContentView(R.layout.face_enroll_education);
 
         setTitle(R.string.security_settings_face_enroll_education_title);
-        setDescriptionText(R.string.security_settings_face_enroll_education_message);
+        setDescriptionText(getTextWithDefaultLocaleFallback(
+                R.string.security_settings_face_enroll_education_message));
 
         mFaceManager = Utils.getFaceManagerOrNull(this);
 
@@ -388,4 +391,15 @@ public class FaceEnrollEducation extends BiometricEnrollBase {
             mIllustrationDefault.start();
         }
     }
+
+    private CharSequence getTextWithDefaultLocaleFallback(int resId) {
+        final CharSequence localized = getText(resId);
+        if (!TextUtils.isEmpty(localized)) {
+            return localized;
+        }
+        final Configuration configuration = new Configuration(
+                getResources().getConfiguration());
+        configuration.setLocale(Locale.ENGLISH);
+        return createConfigurationContext(configuration).getText(resId);
+    }
 }
