From: logix727 <mbstober@gmail.com>
Date: Thu, 13 Aug 2026 10:29:41 -0400
Subject: [PATCH] adb: report complete sideload transfer progress

Change-Id: Ie8bc9721651005c8b287ebca8be6004e5f69270b
---
 Android.bp                        |  1 +
 client/commandline.cpp            | 15 +++++-----
 client/sideload_progress.h        | 49 +++++++++++++++++++++++++++++++
 client/sideload_progress_test.cpp | 45 ++++++++++++++++++++++++++++
 4 files changed, 102 insertions(+), 8 deletions(-)
 create mode 100644 client/sideload_progress.h
 create mode 100644 client/sideload_progress_test.cpp

diff --git a/Android.bp b/Android.bp
index 2d31fa1..90061aa 100644
--- a/Android.bp
+++ b/Android.bp
@@ -265,6 +265,7 @@ libadb_test_srcs = [
     "adb_io_test.cpp",
     "adb_listeners_test.cpp",
     "adb_utils_test.cpp",
+    "client/sideload_progress_test.cpp",
     "fdevent/fdevent_test.cpp",
     "shell_service_protocol.cpp",
     "socket_spec_test.cpp",
diff --git a/client/commandline.cpp b/client/commandline.cpp
index d7a517f..83e477c 100644
--- a/client/commandline.cpp
+++ b/client/commandline.cpp
@@ -64,6 +64,7 @@
 #include "app_processes.pb.h"
 #include "bugreport.h"
 #include "client/file_sync_client.h"
+#include "sideload_progress.h"
 #include "commandline.h"
 #include "fastdeploy.h"
 #include "incremental_server.h"
@@ -926,6 +927,7 @@ static int adb_sideload_install(const char* filename, bool rescue_mode) {
     char buf[SIDELOAD_HOST_BLOCK_SIZE];
 
     int64_t xfer = 0;
+    SideloadProgress progress(sb.st_size, SIDELOAD_HOST_BLOCK_SIZE);
     int last_percent = -1;
     while (true) {
         if (!ReadFdExactly(device_fd, buf, 8)) {
@@ -976,15 +978,12 @@ static int adb_sideload_install(const char* filename, bool rescue_mode) {
         }
         xfer += to_write;
 
-        // For normal OTA packages, we expect to transfer every byte
-        // twice, plus a bit of overhead (one read during
-        // verification, one read of each byte for installation, plus
-        // extra access to things like the zip central directory).
-        // This estimate of the completion becomes 100% when we've
-        // transferred ~2.13 (=100/47) times the package size.
-        int percent = static_cast<int>(xfer * 47LL / (sb.st_size ? sb.st_size : 1));
+        // FUSE may request blocks repeatedly while recovery verifies and installs the package.
+        // Report unique package coverage so transfer progress reaches 100% after every byte has
+        // been served once without pretending to measure recovery's separate install progress.
+        int percent = progress.RecordBlock(block);
         if (percent != last_percent) {
-            printf("\rserving: '%s'  (~%d%%)    ", filename, percent);
+            printf("\rserving: '%s'  (%d%%)    ", filename, percent);
             fflush(stdout);
             last_percent = percent;
         }
diff --git a/client/sideload_progress.h b/client/sideload_progress.h
new file mode 100644
index 0000000..5e955fc
--- /dev/null
+++ b/client/sideload_progress.h
@@ -0,0 +1,49 @@
