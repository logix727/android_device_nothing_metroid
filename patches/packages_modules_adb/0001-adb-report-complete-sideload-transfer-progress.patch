+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "sideload_progress.h"
+
+#include <gtest/gtest.h>
+
+TEST(SideloadProgressTest, CountsEachBlockOnlyOnce) {
+    SideloadProgress progress(4096, 1024);
+
+    EXPECT_EQ(25, progress.RecordBlock(0));
+    EXPECT_EQ(25, progress.RecordBlock(0));
+    EXPECT_EQ(50, progress.RecordBlock(1));
+    EXPECT_EQ(50, progress.RecordBlock(1));
+}
+
+TEST(SideloadProgressTest, HandlesOutOfOrderRequests) {
+    SideloadProgress progress(4096, 1024);
+
+    EXPECT_EQ(25, progress.RecordBlock(3));
+    EXPECT_EQ(50, progress.RecordBlock(1));
+    EXPECT_EQ(75, progress.RecordBlock(2));
+    EXPECT_EQ(100, progress.RecordBlock(0));
+}
+
+TEST(SideloadProgressTest, CountsPartialFinalBlock) {
+    SideloadProgress progress(2500, 1024);
+
+    EXPECT_EQ(40, progress.RecordBlock(0));
+    EXPECT_EQ(81, progress.RecordBlock(1));
+    EXPECT_EQ(100, progress.RecordBlock(2));
+}
