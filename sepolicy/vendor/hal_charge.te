type vendor_hal_charge_default, domain;
type vendor_hal_charge_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_hal_charge_default)
binder_use(vendor_hal_charge_default)
hal_server_domain(vendor_hal_charge_default, vendor_hal_noth_charge)
hal_attribute_service(vendor_hal_noth_charge, vendor_hal_noth_charge_service)

hal_client_domain(system_server, vendor_hal_noth_charge)
hal_client_domain(system_app, vendor_hal_noth_charge)
hal_client_domain(platform_app, vendor_hal_noth_charge)

allow vendor_hal_charge_default vendor_proc_charge:dir r_dir_perms;
allow vendor_hal_charge_default vendor_proc_charge:file rw_file_perms;
allow vendor_hal_charge_default vendor_sysfs_qcom_battery:dir r_dir_perms;
allow vendor_hal_charge_default vendor_sysfs_qcom_battery:file rw_file_perms;
allow vendor_hal_charge_default vendor_sysfs_battery_supply:dir r_dir_perms;
allow vendor_hal_charge_default vendor_sysfs_battery_supply:file rw_file_perms;
allow vendor_hal_charge_default vendor_sysfs_usb_supply:dir r_dir_perms;
allow vendor_hal_charge_default vendor_sysfs_usb_supply:file rw_file_perms;
allow vendor_hal_charge_default sysfs_thermal:dir r_dir_perms;
allow vendor_hal_charge_default sysfs_thermal:file r_file_perms;
allow vendor_hal_charge_default kmsg_device:chr_file rw_file_perms;
