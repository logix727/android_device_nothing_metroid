# Vendor tool that ships with no SELinux label, found while bringing the device to enforcing
# (2026-07-29). It does not block boot — unlike vendor.power.stats-default — but with no domain init
# refuses to exec it under enforcing, so it would silently never run.
#
#   ft_diag_test     /vendor/bin/ft_diag_test   factory diag test
#
# Minimal domain: enough to exec and log. Anything else it needs will show up as a denial and
# can be added deliberately, rather than granting broad access up front.

type vendor_ft_diag_test, domain;
type vendor_ft_diag_test_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_ft_diag_test)
