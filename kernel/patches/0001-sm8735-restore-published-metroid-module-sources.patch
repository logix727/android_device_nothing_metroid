+int aw_check_data_version(struct aw_bin *bin, int bin_num)
+{
+	int i = 0;
+
+	DBG("enter\n");
+
+	for (i = DATA_VERSION_V1; i < DATA_VERSION_MAX; i++) {
+		if (bin->header_info[bin_num].bin_data_ver == i)
+			return 0;
+
+	}
+	DBG_ERR("aw_bin_parse Unrecognized this bin data version\n");
+	return -EINVAL;
+}
