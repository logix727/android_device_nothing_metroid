+
+	ret = aw882xx_dsp_read_dsp_msg(aw_dev, AW_MSG_ID_VERSION,
+				(char *)&algo_ver, sizeof(uint32_t));
+	if ((ret < 0) || (algo_ver == 0)) {
+		ret = aw882xx_dsp_read_dsp_msg(aw_dev, AW_MSG_ID_VERSION_NEW,
+					algo_ver_buf, ALGO_VERSION_MAX);
