+static void aw_dsp_get_check_sum(int pos, void *data, int size, int *check_sum)
+{
+	int i = 0;
+	int sum_data = 0;
+
+	for (i = pos; i < size / sizeof(uint8_t); i++)
+		sum_data += *((uint8_t *)data + sizeof(uint8_t) * i);
+
+
+	*check_sum = sum_data;
+}
