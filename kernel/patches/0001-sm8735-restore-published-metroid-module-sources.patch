+
+#ifdef AW_KERNEL_VER_OVER_6_1_0
+#elif defined AW_KERNEL_VER_OVER_5_10_0
+	fs = force_uaccess_begin();
+#else
+	fs = get_fs();
+	set_fs(KERNEL_DS);
+#endif
+
+	aw_fs_write(fp, buf, strlen(buf), &pos);
+
+#ifdef AW_KERNEL_VER_OVER_6_1_0
+#elif defined AW_KERNEL_VER_OVER_5_10_0
+	force_uaccess_end(fs);
+#else
+	set_fs(fs);
+#endif
+
+	aw_pr_info("channel:%d buf:%s cali_re:%d",
+			channel, buf, cali_re);
+
+	filp_close(fp, NULL);
+	return 0;
+}
