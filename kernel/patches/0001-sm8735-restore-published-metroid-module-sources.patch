+bool aw882xx_cali_check_result(struct aw_cali_desc *cali_desc)
+{
+	if (cali_desc->cali_check_st &&
+		(cali_desc->cali_result == CALI_RESULT_ERROR)) {
+		return false;
+	} else {
+		return true;
+	}
