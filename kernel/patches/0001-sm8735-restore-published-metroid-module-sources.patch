+int aw882xx_dev_parse_check_acf(struct aw_container *aw_cfg)
+{
+	struct aw_cfg_hdr *cfg_hdr = NULL;
+
+	if (aw_cfg == NULL) {
+		aw_pr_err("aw_prof is NULL");
