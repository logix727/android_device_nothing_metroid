+static void aw_monitor_parse_hdr(struct aw_device *aw_dev, uint8_t *data)
+{
+	struct aw_monitor_hdr *monitor_hdr =
+			(struct aw_monitor_hdr *)data;
+	struct aw_monitor_cfg *monitor_cfg = &aw_dev->monitor_desc.monitor_cfg;
