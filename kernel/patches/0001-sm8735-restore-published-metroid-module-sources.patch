+	case AW_CFG_HDR_VER_1_0_0_0:
+		return aw_dev_parse_check_acf_by_hdr_v_1_0_0_0(aw_cfg);
+	default:
+		aw_pr_err("unsupported hdr_version [0x%x]", cfg_hdr->a_hdr_version);
+		return -EINVAL;
+	}
+
+	return 0;
