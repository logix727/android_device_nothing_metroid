+			(cfg_dde[i].type == AW_SKT_TYPE_ID)) {
+			if (cfg_dde[i].data_type == ACF_SEC_TYPE_DSP) {
+				ret = aw_dev_parse_raw_dsp(aw_dev,
+					(uint8_t *)prof_hdr + cfg_dde[i].data_offset,
