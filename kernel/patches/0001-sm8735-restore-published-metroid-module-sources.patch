+static void aw_cali_svc_set_cali_status(struct aw_device *aw_dev, int status)
+{
+	if (status)
+		g_cali_status = true;
+	else
+		g_cali_status = false;
+
+	aw_dev_info(aw_dev->dev, "cali %s",
+		(status == 0) ? ("disable") : ("enable"));
+}
