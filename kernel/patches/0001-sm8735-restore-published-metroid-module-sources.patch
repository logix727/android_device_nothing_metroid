+int aw882xx_dev_get_int_status(struct aw_device *aw_dev, uint16_t *int_status)
+{
+	int ret = -1;
+	unsigned int reg_val = 0;
+
+	ret = aw_dev->ops.aw_i2c_read(aw_dev->i2c, aw_dev->int_desc.st_reg, &reg_val);
+	if (ret < 0)
