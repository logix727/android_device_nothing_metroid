+static void aw882xx_load_fw(struct aw882xx *aw882xx)
+{
+	if (aw882xx->sync_load) {
+		aw882xx_request_firmware(&aw882xx->fw_work.work);
+	} else {
+		queue_delayed_work(aw882xx->work_queue,
+				&aw882xx->fw_work,
+				msecs_to_jiffies(AW882XX_LOAD_FW_DELAY_TIME));
+	}
+}
