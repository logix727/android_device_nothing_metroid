+	}
+
+	/* BSTOCM */
+	if (value & (~AW_BSTOCI_MASK)) {
+		aw_dev_info(aw_dev->dev, "BSTOCI: occur");
+		ret |= INT_TYPE_BSTOC;
+	}
+
+	/* OCDI */
+	if (value & (~AW_OCDI_MASK)) {
+		aw_dev_info(aw_dev->dev, "OCDI: occur");
+		ret |= INT_TYPE_OCDI;
+	}
+
+	/* OTHI */
+	if (value & (~AW_OTHI_MASK)) {
+		aw_dev_info(aw_dev->dev, "OTHI: occur");
+		ret |= INT_TYPE_OTHI;
+	}
+
